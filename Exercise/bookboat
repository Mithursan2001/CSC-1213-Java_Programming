-- v. Retrieve the names of sailors who have reserved a red boat.
SELECT Sname
FROM Sailor
WHERE SailorId IN (
    SELECT SailorId
    FROM Reserves
    WHERE BoatId IN (SELECT BoatId FROM Boat WHERE Bcolor = 'red')
);
