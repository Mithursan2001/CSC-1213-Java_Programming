-- viii. Find the names of sailors who have reserved a red boat or a green boat.
SELECT DISTINCT Sname
FROM Sailor
WHERE SailorId IN (
    SELECT SailorId
    FROM Reserves
    WHERE BoatId IN (SELECT BoatId 
	FROM Boat WHERE Bcolor IN ('red', 'green'))
