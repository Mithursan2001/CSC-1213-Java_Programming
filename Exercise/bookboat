-- ix. Find the names of sailors who have reserved 
-- a red boat and a green boat.
SELECT Sname
FROM Sailor
WHERE SailorId IN (
    SELECT SailorId
    FROM Reserves
    WHERE BoatId IN (SELECT BoatId 
	FROM Boat WHERE Bcolor = 'red')
)
AND SailorId IN (
    SELECT SailorId
    FROM Reserves
    WHERE BoatId IN (SELECT BoatId 
	FROM Boat WHERE Bcolor = 'green')
);

--or
SELECT S.Sname
FROM Sailor S
WHERE S.SailorId IN (
    SELECT R1.SailorId
    FROM Reserves R1
    JOIN Boat B1 ON R1.BoatId = B1.BoatId
    WHERE B1.Bcolor = 'red'
)
AND S.SailorId IN (
    SELECT R2.SailorId
    FROM Reserves R2
    JOIN Boat B2 ON R2.BoatId = B2.BoatId
    WHERE B2.Bcolor = 'green'
);

+--------+
| Sname  |
+--------+
| Dustin |
| Lubber |
+--------+

